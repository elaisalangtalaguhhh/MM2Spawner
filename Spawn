local function getWeaponSlot(name)
    -- 1) Most reliable: ask the game's own Database
    local ok, DataBase = pcall(function()
        return require(game:GetService("ReplicatedStorage").Database.Sync.Item)
    end)
    if ok and DataBase and DataBase[name] then
        local ok2, slot = pcall(function()
            local info = DataBase[name]
            if type(info) == "table" then
                -- try common field names used by MM2
                local t = info.ItemType or info.Type or info.Category or info.Kind or info.WeaponType or info.Weapon or info.Slot
                if t then return tostring(t) end
                -- some DBs store booleans like {Gun = true} / {Knife = true}
                if info.Gun then return "Gun" end
                if info.Knife or info.Melee or info.Blade then return "Knife" end
            elseif type(info) == "string" then
                return info
            end
            return nil
        end)
        if ok2 and slot then
            local s = string.lower(slot)
            if string.find(s, "gun") then return "Gun" end
            if string.find(s, "knife") or string.find(s, "melee") or string.find(s, "blade")
                or string.find(s, "axe") or string.find(s, "sword") or string.find(s, "scythe")
                or string.find(s, "bat") then
                return "Knife"
            end
        end
    end

    -- 2) Explicit fallback map above
    if itemTypes[name] then
        return itemTypes[name]
    end

    -- 3) Heuristic fallback (old logic was case-sensitive and missed _G/_K, Darkshot, Flora, etc.)
    local lower = string.lower(name)
    if string.find(lower, "gun") or string.find(name, "_G") then
        return "Gun"
    end
    return "Knife"
end

-- Inventory-first system: Spawn ONLY adds to Owned, NEVER touches Equipped.
-- This forces the normal MM2 flow: open Inventory -> tap item -> game equips it.
-- Old code did PlayerData.Weapons = PlayerWeapons every frame, which overwrote
-- manual taps and blocked inventory equipping. We now pin ONLY Owned.
local SpawnedOwned = {}

local function pinOwnedOnly()
    local RunService = game:GetService("RunService")
    pcall(function() RunService:UnbindFromRenderStep("InventoryUpdate") end)
    RunService:BindToRenderStep("InventoryUpdate", 0, function()
        local ok, PlayerData = pcall(function()
            return require(game:GetService("ReplicatedStorage").Modules.ProfileData)
        end)
        if not ok or not PlayerData or not PlayerData.Weapons then return end
        PlayerData.Weapons.Owned = PlayerData.Weapons.Owned or {}
        -- re-apply every spawned item so server/client wipes don't remove them
        -- but NEVER touch PlayerData.Weapons.Equipped here, so inventory taps stick
        for name, count in pairs(SpawnedOwned) do
            local cur = PlayerData.Weapons.Owned[name]
            if cur == nil then
                PlayerData.Weapons.Owned[name] = count
            elseif typeof(cur) == "number" and typeof(count) == "number" then
                if cur < count then
                    PlayerData.Weapons.Owned[name] = count
                end
            end
        end
    end)
end

local function tryRefreshInventoryUI()
    -- Best-effort: MM2 builds inventory UI from ProfileData, try common refresh paths.
    -- All wrapped in pcall so nothing breaks if the game updated.
    pcall(function()
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        -- 1) Common inventory refresh remotes/functions
        for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
            if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") or v:IsA("BindableEvent") then
                local n = string.lower(v.Name)
                if string.find(n, "refreshinventory") or string.find(n, "updateinventory") or string.find(n, "inventoryrefresh") then
                    if v:IsA("RemoteEvent") or v:IsA("BindableEvent") then pcall(function() v:Fire() end)
                    elseif v:IsA("RemoteFunction") then pcall(function() v:InvokeServer() end) end
                end
            end
        end
    end)
    pcall(function()
        -- 2) Try calling Inventory module refresh if it exists
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local inv = ReplicatedStorage:FindFirstChild("Modules")
        if inv then
            local ok, mod = pcall(function() return require(ReplicatedStorage.Modules:FindFirstChild("Inventory")) end)
            if ok and mod and type(mod) == "table" then
                if type(mod.Refresh) == "function" then pcall(mod.Refresh)
                elseif type(mod.Update) == "function" then pcall(mod.Update)
                elseif type(mod.Reload) == "function" then pcall(mod.Reload) end
            end
        end
    end)
    pcall(function()
        -- 3) Toggle inventory GUI off/on to force rebuild (MM2 MainGUI / InventoryGUI)
        local pg = game.Players.LocalPlayer:WaitForChild("PlayerGui", 2)
        if pg then
            for _, guiName in ipairs({"MainGUI", "InventoryGUI", "Inventory", "Menu"}) do
                local g = pg:FindFirstChild(guiName)
                if g then
                    local inv = g:FindFirstChild("Inventory", true) or g:FindFirstChild("Container", true)
                    if inv and inv:IsA("GuiObject") then
                        local was = inv.Visible
                        inv.Visible = not was
                        task.wait()
                        inv.Visible = was
                    end
                end
            end
        end
    end)
end

local function getPlayerWeapons()
    local ok, _, PlayerData = pcall(function()
        return require(game:GetService("ReplicatedStorage").Database.Sync.Item), require(game:GetService("ReplicatedStorage").Modules.ProfileData)
    end)
    if not ok or not PlayerData then return nil, nil end
    local PlayerWeapons = PlayerData.Weapons
    if not PlayerWeapons then return nil, nil end
    PlayerWeapons.Owned = PlayerWeapons.Owned or {}
    PlayerWeapons.Equipped = PlayerWeapons.Equipped or {}
    return PlayerData, PlayerWeapons
end

-- Manual helpers (optional shortcuts). Spawn itself does NOT call these,
-- so normal flow is: Spawn -> open Inventory -> tap item to equip.
local function equipOnly(name)
    local PlayerData, PlayerWeapons = getPlayerWeapons()
    if not PlayerData then return false end
    if not PlayerWeapons.Owned[name] then
        PlayerWeapons.Owned[name] = 1
        SpawnedOwned[name] = 1
    end
    local slot = getWeaponSlot(name)
    if slot == "Gun" then
        PlayerWeapons.Equipped.Gun = name
    else
        PlayerWeapons.Equipped.Knife = name
        PlayerWeapons.Equipped.Melee = name
    end
    pinOwnedOnly()
    tryRefreshInventoryUI()
    return true
end

local function unequipOnly(name)
    local PlayerData, PlayerWeapons = getPlayerWeapons()
    if not PlayerData then return false end
    local slot = getWeaponSlot(name)
    -- Reset to MM2 defaults (Knife / Gun). Don't delete Owned so it stays in inventory.
    if slot == "Gun" then
        PlayerWeapons.Equipped.Gun = "Gun"
    else
        PlayerWeapons.Equipped.Knife = "Knife"
        PlayerWeapons.Equipped.Melee = "Knife"
    end
    pinOwnedOnly()
    tryRefreshInventoryUI()
    return true
end

-- Spawn to INVENTORY ONLY. Does NOT equip, does NOT respawn.
-- Player MUST open inventory and tap the item to equip (normal MM2 behavior).
local function spawnToInventory(name)
    local PlayerData, PlayerWeapons = getPlayerWeapons()
    if not PlayerData then return end

    if not PlayerWeapons.Owned[name] then
        PlayerWeapons.Owned[name] = 1
        SpawnedOwned[name] = 1
    elseif typeof(PlayerWeapons.Owned[name]) == "number" then
        PlayerWeapons.Owned[name] += 1
        SpawnedOwned[name] = PlayerWeapons.Owned[name]
    else
        SpawnedOwned[name] = SpawnedOwned[name] or 1
    end

    -- DO NOT touch Equipped here on purpose.
    pinOwnedOnly()
    tryRefreshInventoryUI()
    -- NO BreakJoints: killing the player closes inventory and isn't needed for tap-to-equip.
end

-- Kept for backwards compat: old Spawn+Equip button now just spawns to inventory.
local function spawnAndEquipItem(name, doRespawn)
    spawnToInventory(name)
end

-- Progress Bar Animation (mode: "spawn" | "equip" | "unequip")
local function showProgress(customName, mode)
    mode = mode or "spawn"
    local originalName = getOriginalName(customName)
    TweenService:Create(progressFrame, TweenInfo.new(0.3), {BackgroundTransparency = 0}):Play()
    TweenService:Create(progressLabel, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
    TweenService:Create(barBG, TweenInfo.new(0.3), {BackgroundTransparency = 0}):Play()
    TweenService:Create(barFill, TweenInfo.new(0.3), {BackgroundTransparency = 0}):Play()

    local verb = mode == "equip" and "Equipping: " or mode == "unequip" and "Unequipping: " or "Spawning: "
    local percent = 0
    while percent < 100 do
        percent += math.random(10, 25)
        percent = math.clamp(percent, 0, 100)
        progressLabel.Text = verb .. customName .. " (" .. percent .. "%)"
        barFill:TweenSize(UDim2.new(percent / 100, 0, 1, 0), "Out", "Quad", 0.1, true)
        task.wait(0.2)
    end

    if mode == "equip" then
        progressLabel.Text = "Equipped: " .. customName .. " (or tap in Inventory)"
        equipOnly(originalName)
    elseif mode == "unequip" then
        progressLabel.Text = "Unequipped: " .. customName
        unequipOnly(originalName)
    else
        progressLabel.Text = "In Inventory: open it & tap " .. customName
        spawnToInventory(originalName)
    end

    task.delay(0.6, function()
        TweenService:Create(progressFrame, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
        TweenService:Create(progressLabel, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
        TweenService:Create(barBG, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
        TweenService:Create(barFill, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
    end)
end

-- Button Connections
spawnButton.MouseButton1Click:Connect(function()
    local itemName = inputBox.Text
    if itemName == "" then return end

    local grow = TweenService:Create(spawnButton, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0.47, 0, 0, 27)})
    grow:Play()
    grow.Completed:Connect(function()
        spawnButton:TweenSize(UDim2.new(0.45, 0, 0, 25), "Out", "Quad", 0.1, true)
    end)

    showProgress(itemName, "spawn")
    inputBox.Text = ""
end)

equipButton.MouseButton1Click:Connect(function()
    local itemName = inputBox.Text
    if itemName == "" then return end
    showProgress(itemName, "equip")
    inputBox.Text = ""
end)

unequipButton.MouseButton1Click:Connect(function()
    local itemName = inputBox.Text
    if itemName == "" then return end
    showProgress(itemName, "unequip")
    inputBox.Text = ""
end)

closeButton.MouseButton1Click:Connect(function()
    screenGui:Destroy()
end)

