-- testing.lua - minimal Ginger-hip fix on ORIGINAL. No joints, no CFrames, no player spin.
-- Ginger hip: locked flip+shrink once. Held Ginger: same size, default hold. Others: game default.

if not isfile("mm2data.lua") then
    local result = request({
        Url = "https://raw.githubusercontent.com/Lutosys/opensrc/refs/heads/main/mm2meshes.lua",
        Method = "GET",
    })
    if result.Success then
        writefile("mm2data.lua", result.Body)
    end
end

data = loadfile("mm2data.lua")() or nil
if not data then
    return warn("failed to load data")
end

local function findMeshAndTexture(node)
    if not node or type(node) ~= "table" then return nil end
    local props = node.Props
    if props then
        local meshId = props.MeshId or props.MeshID or props.SearchId or props.SearchID
        if meshId and meshId ~= "" then
            return {
                meshid = meshId,
                textureid = props.TextureId or props.TextureID or "",
                scale = props.Scale or Vector3.new(1,1,1),
                size = props.Size or Vector3.new(0.2697,1.2582,4.2087),
                kind = props.Scale and "FileMesh" or "MeshPart"
            }
        end
    end
    if node.Display and type(node.Display) == "table" then
        local partSize
        for _, child in ipairs(node.Display) do
            local p = child.Props
            if p and p.Size then partSize = p.Size end
        end
        for _, child in ipairs(node.Display) do
            local p = child.Props
            if p then
                local mid = p.MeshId or p.MeshID or p.SearchId or p.SearchID
                if mid and mid ~= "" then
                    return {
                        meshid = mid,
                        textureid = p.TextureId or p.TextureID or "",
                        scale = p.Scale or Vector3.new(1,1,1),
                        size = p.Size or partSize or Vector3.new(0.2697,1.2582,4.2087),
                        kind = (child.Class == "MeshPart") and "MeshPart" or "FileMesh"
                    }
                end
            end
        end
    end
    return nil
end

local function normName(s)
    s = tostring(s or ""):lower()
    s = s:gsub("[%s%-%_]+", "")
    return s
end
local DataIndex = {}
for key, entry in pairs(data) do
    if type(entry) == "table" then
        DataIndex[normName(key)] = DataIndex[normName(key)] or key
        local base = tostring(key):gsub("_G_%d+$", ""):gsub("_K_%d+$", ""):gsub("_%d+$", "")
        DataIndex[normName(base)] = DataIndex[normName(base)] or key
        if entry.Meta and entry.Meta.ItemName then
            DataIndex[normName(entry.Meta.ItemName)] = DataIndex[normName(entry.Meta.ItemName)] or key
        end
    end
end

local function getWeaponData(name)
    if not name then return nil end
    if data[name] then return findMeshAndTexture(data[name]) end
    local key = DataIndex[normName(name)]
    if key and data[key] then return findMeshAndTexture(data[key]) end
    return nil
end

local GINGER_ID = "15374602183"
local GINGER_DISPLAY_SCALE = 0.12 -- ginger hip+held size, others untouched
local OTHER_SCALE = 1 -- every other gun/sword, hip+held, true size
if not _G.SBBase then _G.SBBase = {} end
if not _G.SBApplied then _G.SBApplied = {} end
if not _G.SBJointOrig then _G.SBJointOrig = {} end
if not _G.SBAttachOrig then _G.SBAttachOrig = {} end

-- Undo Sunrise/Blossom yaw on a shared slot so later guns come back straight.
local function restoreSB(refPart)
    if not _G.SBApplied[refPart] then return end
    if _G.SBBase[refPart] then
        pcall(function() refPart.CFrame = _G.SBBase[refPart] end)
        _G.SBBase[refPart] = nil
    end
    for j, c0 in pairs(_G.SBJointOrig) do
        if j.Part1 == refPart then pcall(function() j.C0 = c0 end) end
        _G.SBJointOrig[j] = nil
    end
    for a, cf in pairs(_G.SBAttachOrig) do
        if a.Parent == refPart then pcall(function() a.CFrame = cf end) end
        if a.Parent == refPart then _G.SBAttachOrig[a] = nil end
    end
    _G.SBApplied[refPart] = nil
end
getgenv().GingerRunId = (getgenv().GingerRunId or 0) + 1
local MY_RUN = getgenv().GingerRunId
if not _G.GingerHipLocked then _G.GingerHipLocked = {} end
if not _G.GingerMeshOrig then _G.GingerMeshOrig = {} end

local function applyWeaponMesh(refPart, weaponData, weaponName, weapontype)
    local isDisplay = (weapontype == nil) or (refPart:FindFirstAncestorOfClass("Tool") == nil)
    if not weaponData or not weaponData.meshid then
        -- Unknown gun: straighten slot (SB yaw never sticks) + release stale Ginger.
        if isDisplay then restoreSB(refPart) end
        if isDisplay and _G.GingerHipLocked[refPart] then
            local snap = _G.GingerMeshOrig[refPart]
            if snap then
                if refPart:IsA("MeshPart") then
                    if snap.MeshId then refPart.MeshId = snap.MeshId end
                    if snap.TextureID then refPart.TextureID = snap.TextureID end
                else
                    local m0 = refPart:FindFirstChildOfClass("SpecialMesh")
                    if m0 then
                        if snap.MeshId then m0.MeshId = snap.MeshId end
                        if snap.TextureId then m0.TextureId = snap.TextureId end
                        if snap.Scale then m0.Scale = snap.Scale * OTHER_SCALE end
                    end
                end
            end
            _G.GingerHipLocked[refPart] = nil
            _G.GingerMeshOrig[refPart] = nil
            restoreSB(refPart)
        end
        return
    end
    local isGinger = weaponData.meshid:find(GINGER_ID) ~= nil

    if isGinger and isDisplay and _G.GingerHipLocked[refPart] then
        -- Validate lock: game resets preview meshes on spawn/refresh. Re-apply if lost.
        local stillFlipped = false
        if refPart:IsA("MeshPart") then
            stillFlipped = (refPart.MeshId == weaponData.meshid)
        else
            local m = refPart:FindFirstChildOfClass("SpecialMesh")
            stillFlipped = m and (m.MeshId == weaponData.meshid)
                and m.Scale.X > 0 and m.Scale.Y < 0 and m.Scale.Z < 0
                or false
        end
        if stillFlipped then return end
        _G.GingerHipLocked[refPart] = nil
        restoreSB(refPart)
    end

    -- ORIGINAL Grip logic untouched (hand default).
    if weaponData.meshid:find("79401392") then
        if weapontype == "Gun" then
            local tool = refPart:FindFirstAncestorOfClass("Tool")
            if tool then
                tool.Grip = CFrame.fromMatrix(
                    Vector3.new(0, -0.699999988, -0.300000012),
                    Vector3.new(1, 0, 0),
                    Vector3.new(0, 0, 1),
                    Vector3.new(0, -1, 0)
                )
            end
        end
    elseif weaponData.meshid:find("6600918074") then
        if weapontype == "Gun" then
            local tool = refPart:FindFirstAncestorOfClass("Tool")
            if tool then
                tool.Grip = CFrame.new(1, -0.359999988, 0.00000012, 0, 0, 1, 0, 1, 0, -1, 0, 0)
            end
        end
    else
        if weapontype == "Gun" then
            local tool = refPart:FindFirstAncestorOfClass("Tool")
            if tool then
                tool.Grip = CFrame.fromMatrix(
                    Vector3.new(0, -0.5, 0.7),
                    Vector3.new(1, 0, 0),
                    Vector3.new(0, 1, 0),
                    Vector3.new(0, 0, 1)
                )
            end
        end
    end

    if refPart:IsA("MeshPart") then
        if isGinger and isDisplay and not _G.GingerMeshOrig[refPart] then
            _G.GingerMeshOrig[refPart] = {MeshId = refPart.MeshId, TextureID = refPart.TextureID}
        end
        -- Non-ginger MeshPart cross-type guard: only same-type shows, else restore/leave.
        if not isGinger then
            if isDisplay then restoreSB(refPart) end
            if _G.GingerHipLocked[refPart] then
                local snap = _G.GingerMeshOrig[refPart]
                if snap then
                    if snap.MeshId then refPart.MeshId = snap.MeshId end
                    if snap.TextureID then refPart.TextureID = snap.TextureID end
                end
                _G.GingerHipLocked[refPart] = nil
                _G.GingerMeshOrig[refPart] = nil
                restoreSB(refPart)
            end
            if (weaponData.kind or "FileMesh") ~= "MeshPart" then return end
        end
        local specialMesh = refPart:FindFirstChildOfClass("SpecialMesh")
        if specialMesh then specialMesh:Destroy() end
        refPart.MeshId = weaponData.meshid
        refPart.TextureID = weaponData.textureid
        if isGinger and isDisplay then _G.GingerHipLocked[refPart] = true end
        if not isGinger then refPart.Size = weaponData.size * OTHER_SCALE end
    else
        local mesh = refPart:FindFirstChildOfClass("SpecialMesh")
        if not mesh then
            mesh = Instance.new("SpecialMesh")
            mesh.Name = "Mesh"
            mesh.Parent = refPart
        end
        if isGinger and isDisplay then
            if not _G.GingerMeshOrig[refPart] then
                _G.GingerMeshOrig[refPart] = {MeshId = mesh.MeshId, TextureId = mesh.TextureId, Scale = mesh.Scale}
            end
            -- Proven flip+shrink. No joints, no CFrames: cannot spin player.
            mesh.MeshId = weaponData.meshid
            mesh.TextureId = weaponData.textureid
            mesh.Scale = Vector3.new(GINGER_DISPLAY_SCALE,-GINGER_DISPLAY_SCALE,-GINGER_DISPLAY_SCALE)
            _G.GingerHipLocked[refPart] = true
        elseif isGinger and not isDisplay then
            -- Held Ginger: same tiny size as hip, positive default orientation.
            mesh.MeshId = weaponData.meshid
            mesh.TextureId = weaponData.textureid
            mesh.Scale = Vector3.new(GINGER_DISPLAY_SCALE,GINGER_DISPLAY_SCALE,GINGER_DISPLAY_SCALE)
        else
            -- Other guns: straighten slot first (SB yaw never sticks), then release
            -- stale Ginger, same-type IDs only so never giant.
            if isDisplay then restoreSB(refPart) end
            if _G.GingerHipLocked[refPart] then
                local snap = _G.GingerMeshOrig[refPart]
                if snap then
                    if snap.MeshId then mesh.MeshId = snap.MeshId end
                    if snap.TextureId then mesh.TextureId = snap.TextureId end
                    if snap.Scale then mesh.Scale = snap.Scale * OTHER_SCALE end
                end
                _G.GingerHipLocked[refPart] = nil
                _G.GingerMeshOrig[refPart] = nil
                restoreSB(refPart)
            end
            if (weaponData.kind or "FileMesh") ~= "FileMesh" then
                -- cross-type new MeshPart gun in old Part slot: restore default look instead of giant
                local snap2 = _G.GingerMeshOrig[refPart]
                if snap2 then
                    if snap2.MeshId then mesh.MeshId = snap2.MeshId end
                    if snap2.TextureId then mesh.TextureId = snap2.TextureId end
                    if snap2.Scale then mesh.Scale = snap2.Scale * OTHER_SCALE end
                end
                return
            end
            mesh.MeshId = weaponData.meshid
            mesh.TextureId = weaponData.textureid
            -- Sunrise + Blossom hip: same Ginger X-flip, own magnitude so size unchanged.
            local mid = weaponData.meshid or ""
            local flipHip = isDisplay and (mid:find("12322809632") or mid:find("109742397574153"))
            if flipHip then
                local s0 = weaponData.scale
                mesh.Scale = Vector3.new(-math.abs(s0.X),math.abs(s0.Y),math.abs(s0.Z))
                -- Yaw 90 only if nothing ties this part to your character (local check).
                local char = game.Players.LocalPlayer.Character
                local tied = char and refPart:IsDescendantOf(char)
                if not tied and char then
                    local function linkedToChar(inst)
                        if inst:IsA("Motor6D") or inst:IsA("Weld") or inst:IsA("WeldConstraint") then
                            local o = (inst.Part0 == refPart) and inst.Part1 or ((inst.Part1 == refPart) and inst.Part0 or nil)
                            if o and o:IsDescendantOf(char) then return true end
                        elseif inst:IsA("RigidConstraint") then
                            local a0 = inst.Attachment0 and inst.Attachment0.Parent
                            local a1 = inst.Attachment1 and inst.Attachment1.Parent
                            local o = (a0 == refPart) and a1 or ((a1 == refPart) and a0 or nil)
                            if o and o:IsDescendantOf(char) then return true end
                        end
                        return false
                    end
                    for _, c in ipairs(refPart:GetChildren()) do
                        if linkedToChar(c) then tied = true break end
                    end
                    if not tied and refPart.Parent then
                        for _, c in ipairs(refPart.Parent:GetChildren()) do
                            if (c:IsA("Motor6D") or c:IsA("Weld") or c:IsA("WeldConstraint") or c:IsA("RigidConstraint")) and linkedToChar(c) then
                                tied = true break
                            end
                        end
                    end
                end
                if not tied then
                    _G.SBBase[refPart] = _G.SBBase[refPart] or refPart.CFrame
                    refPart.CFrame = _G.SBBase[refPart] * CFrame.Angles(0,math.rad(-90),0)
                    _G.SBApplied[refPart] = true
                else
                    -- Tied: rotate item-side only. Motor/Weld C0 when display is Part1,
                    -- else own Attachments. Never touches character side.
                    local moved = false
                    local function tryJoint(inst)
                        if (inst:IsA("Motor6D") or inst:IsA("Weld")) and inst.Part1 == refPart then
                            if not _G.SBJointOrig[inst] then _G.SBJointOrig[inst] = inst.C0 end
                            inst.C0 = _G.SBJointOrig[inst] * CFrame.Angles(0,math.rad(-90),0)
                            moved = true
                        end
                    end
                    for _, c in ipairs(refPart:GetChildren()) do tryJoint(c) end
                    if refPart.Parent then
                        for _, c in ipairs(refPart.Parent:GetChildren()) do tryJoint(c) end
                    end
                    if not moved then
                        for _, a in ipairs(refPart:GetChildren()) do
                            if a:IsA("Attachment") then
                                if not _G.SBAttachOrig[a] then _G.SBAttachOrig[a] = a.CFrame end
                                a.CFrame = _G.SBAttachOrig[a] * CFrame.Angles(0,math.rad(-90),0)
                                moved = true
                            end
                        end
                    end
                    if moved then _G.SBApplied[refPart] = true end
                end
            else
                mesh.Scale = weaponData.scale * OTHER_SCALE
            end
        end
    end
end

local InventoryModule = require(game.ReplicatedStorage.Modules.InventoryModule)
local ProfileData = require(game.ReplicatedStorage.Modules.ProfileData)
local Sync = require(game.ReplicatedStorage.Database.Sync)

for name, itemData in pairs(Sync.Weapons) do
    itemData.SortWithinGroup = itemData.SortWithinGroup or 0
    itemData.SortGroup = itemData.SortGroup or nil
    itemData.Name = itemData.Name or itemData.ItemName or name
    itemData.Rarity = itemData.Rarity or "Common"
    if Sync.Rarities[itemData.Rarity] then
        local weaponMeshInfo = getWeaponData(name)
        if weaponMeshInfo and weaponMeshInfo.meshid and weaponMeshInfo.textureid and weaponMeshInfo.scale and weaponMeshInfo.size then
            ProfileData.Weapons.Owned[name] = 1
        end
    end
end

local UpdateInventory = filtergc("table", {Keys = {"UpdateInventory"}}, true).UpdateInventory
for key, func in pairs(getgc()) do
    if typeof(func) == "function" and islclosure(func) and debug.info(func, "l") == 122 and #debug.getupvalues(func) == 2 then
        UpdateInventory(debug.getupvalue(func, 2), InventoryModule.MyInventory)
    end
end

local function isMurder()
    local success, result = pcall(function()
        for _, v in pairs(game.Players.LocalPlayer.Character:GetChildren()) do
            if typeof(v) == "Instance" and v:IsA("Tool") and v:GetAttribute("ItemType") == "Knife" then
                return true
            end
        end
        for _, v in pairs(game.Players.LocalPlayer.Backpack:GetChildren()) do
            if typeof(v) == "Instance" and v:IsA("Tool") and v:GetAttribute("ItemType") == "Knife" then
                return true
            end
        end
        return false
    end)
    if success then return result end
    return false
end

game.Workspace.ChildAdded:Connect(function(ch)
    if ch and ch:IsA("BasePart") and ch.Name == "StuckKnife" then
        local mesh = ch:WaitForChild("Mesh")
        if mesh then
            local equippedKnifeName = ProfileData.Weapons.Equipped.Knife
            local knifedata = getWeaponData(equippedKnifeName)
            if knifedata and isMurder() then
                mesh.MeshId = knifedata.meshid
                mesh.TextureId = knifedata.textureid
                mesh.Scale = knifedata.scale
            end
        end
    end
end)

while wait() do
    if MY_RUN ~= getgenv().GingerRunId then break end
    local char = game.Players.LocalPlayer.Character
    if char then
        local equippedKnifeName = ProfileData.Weapons.Equipped.Knife
        local equippedGunName = ProfileData.Weapons.Equipped.Gun
        for _, tool in pairs(char:GetChildren()) do
            if tool and tool:IsA("Tool") then
                local itemType = tool:GetAttribute("ItemType")
                local Handle = tool:FindFirstChild("Handle")
                if Handle then
                    if itemType == "Knife" and equippedKnifeName then
                        local knifedata = getWeaponData(equippedKnifeName)
                        if knifedata and knifedata.meshid and knifedata.textureid and knifedata.scale and knifedata.size then
                            applyWeaponMesh(Handle, knifedata, equippedKnifeName, "Knife")
                        end
                    elseif itemType == "Gun" and equippedGunName then
                        local gundata = getWeaponData(equippedGunName)
                        if gundata and gundata.meshid and gundata.textureid and gundata.scale and gundata.size then
                            applyWeaponMesh(Handle, gundata, equippedGunName, "Gun")
                        end
                    end
                end
            end
        end
        local DisplayRefGun = char:FindFirstChild("DisplayRefGun")
        if DisplayRefGun then
            local refVal = DisplayRefGun.Value
            if refVal and typeof(refVal) == "Instance" and equippedGunName then
                local gundata = getWeaponData(equippedGunName)
                if gundata and gundata.meshid and gundata.textureid and gundata.scale and gundata.size then
                    applyWeaponMesh(refVal, gundata, equippedGunName)
                elseif _G.GingerHipLocked[refVal] then
                    applyWeaponMesh(refVal, nil, equippedGunName)
                end
            end
        end
        local DisplayRefKnife = char:FindFirstChild("DisplayRefKnife")
        if DisplayRefKnife then
            local refVal = DisplayRefKnife.Value
            if refVal and typeof(refVal) == "Instance" and equippedKnifeName then
                local knifedata = getWeaponData(equippedKnifeName)
                if knifedata and knifedata.meshid and knifedata.textureid and knifedata.scale and knifedata.size then
                    applyWeaponMesh(refVal, knifedata, equippedKnifeName)
                elseif _G.GingerHipLocked[refVal] then
                    applyWeaponMesh(refVal, nil, equippedKnifeName)
                end
            end
        end
    end
end
