data = loadfile("mm2data.lua")() or nil
if not data then
    return warn("failed to load data")
end

local function findMeshAndTexture(node)
    if not node or type(node) ~= "table" then return nil end
    local props = node.Props
    if props then
        local meshId = props.MeshId or props.MeshID or props.SearchId or props.SearchID
        if meshId and meshId ~= "" then
            local textureId = props.TextureId or props.TextureID or ""
            local scale = props.Scale or Vector3.new(1, 1, 1)
            local size = props.Size or Vector3.new(0.2697, 1.2582, 4.2087)
            return { meshid = meshId, textureid = textureId, scale = scale, size = size }
        end
    end
    if node.Display and type(node.Display) == "table" then
        local foundSize, foundMesh, foundTex, foundScale
        for _, child in ipairs(node.Display) do
            local p = child.Props
            if p then
                if p.Size then foundSize = p.Size end
                local mid = p.MeshId or p.MeshID or p.SearchId or p.SearchID
                if mid and mid ~= "" then foundMesh = mid end
                local tid = p.TextureId or p.TextureID
                if tid ~= nil then foundTex = tid end
                if p.Scale then foundScale = p.Scale end
                if mid and mid ~= "" then
                    return {
                        meshid = mid,
                        textureid = tid or foundTex or "",
                        scale = p.Scale or Vector3.new(1, 1, 1),
                        size = p.Size or foundSize or Vector3.new(0.2697, 1.2582, 4.2087)
                    }
                end
            end
        end
        if foundMesh then
            return {
                meshid = foundMesh,
                textureid = foundTex or "",
                scale = foundScale or Vector3.new(1, 1, 1),
                size = foundSize or Vector3.new(0.045, 0.045, 0.045)
            }
        end
        for _, child in ipairs(node.Display) do
            local res = findMeshAndTexture(child)
            if res then return res end
        end
    end
    return nil
end

local function getWeaponData(name)
    local weaponData = data[name]
    if not weaponData then return nil end
    return findMeshAndTexture(weaponData)
end

if not _G.GingerOrig then _G.GingerOrig = {} end
local GINGER_ID = "15374602183"
local GINGER_SCALE = 0.7 -- lower = smaller, 1.0 = current big, try 0.6-0.8 to match pic 2

local function applyWeaponMesh(refPart, weaponData, weaponName, weapontype)
    if not weaponData or not weaponData.meshid then return end
    local isGinger = weaponData.meshid:find(GINGER_ID) ~= nil
    local isDisplay = (weapontype == nil) or (refPart:FindFirstAncestorOfClass("Tool") == nil)

    -- HELD gun in hand: Grip only, keep normal size
    if not isDisplay then
        if weapontype == "Gun" then
            local tool = refPart:FindFirstAncestorOfClass("Tool")
            if tool and isGinger then
                tool.Grip = CFrame.fromMatrix(
                    Vector3.new(0, -0.5, 0.7),
                    Vector3.new(1, 0, 0),
                    Vector3.new(0, -1, 0),
                    Vector3.new(0, 0, -1)
                )
            elseif tool and weaponData.meshid:find("79401392") then
                tool.Grip = CFrame.fromMatrix(
                    Vector3.new(0, -0.699999988, -0.300000012),
                    Vector3.new(1, 0, 0),
                    Vector3.new(0, 0, 1),
                    Vector3.new(0, -1, 0)
                )
            elseif tool and weaponData.meshid:find("6600918074") then
                tool.Grip = CFrame.new(1, -0.359999988, 0.00000012, 0, 0, 1, 0, 1, 0, -1, 0, 0)
            elseif tool and weapontype == "Gun" then
                tool.Grip = CFrame.fromMatrix(
                    Vector3.new(0, -0.5, 0.7),
                    Vector3.new(1, 0, 0),
                    Vector3.new(0, 1, 0),
                    Vector3.new(0, 0, 1)
                )
            end
        end
    end

    -- DISPLAY (hip) + HELD mesh swap
    if refPart:IsA("MeshPart") then
        -- MeshPart can't use negative Scale, try weld C0 flip for display
        if isGinger and isDisplay then
            pcall(function()
                local joint = refPart:FindFirstChildOfClass("Motor6D") or refPart:FindFirstChildOfClass("Weld")
                if not joint and refPart.Parent then
                    for _, c in ipairs(refPart.Parent:GetChildren()) do
                        if (c:IsA("Motor6D") or c:IsA("Weld")) and (c.Part0 == refPart or c.Part1 == refPart) then
                            joint = c break
                        end
                    end
                end
                print("[Ginger] MeshPart display joint:", joint and joint.ClassName or "NONE - WeldConstraint?")
                if joint then
                    if not _G.GingerOrig[joint] then _G.GingerOrig[joint] = joint.C0 end
                    joint.C0 = _G.GingerOrig[joint] * CFrame.Angles(math.rad(180), 0, 0)
                end
            end)
        end
        local sm = refPart:FindFirstChildOfClass("SpecialMesh")
        if sm then sm:Destroy() end
        -- KEEP SIZE for display so it doesn't get bigger, only change mesh
        if not isDisplay then
            refPart.Size = weaponData.size
        end
        refPart.MeshId = weaponData.meshid
        refPart.TextureID = weaponData.textureid
    else
        local mesh = refPart:FindFirstChildOfClass("SpecialMesh")
        if not mesh then
            mesh = Instance.new("SpecialMesh")
            mesh.Name = "Mesh"
            mesh.Parent = refPart
        end
        if isGinger and isDisplay then
            -- Flip via negative Scale = 180 X rotation, no weld edit, no size change
            -- This is what actually rotates muzzle down on hip
            print("[Ginger] Part display flip via Scale")
            mesh.MeshId = weaponData.meshid
            mesh.TextureId = weaponData.textureid
            local s = weaponData.scale
            -- use base scale flipped + GINGER_SCALE shrink, keep part size unchanged
            mesh.Scale = Vector3.new(s.X * GINGER_SCALE, -math.abs(s.Y) * GINGER_SCALE, -math.abs(s.Z) * GINGER_SCALE)
            -- DO NOT touch refPart.Size here
        else
            refPart.Size = weaponData.size
            mesh.MeshId = weaponData.meshid
            mesh.TextureId = weaponData.textureid
            mesh.Scale = weaponData.scale
        end
    end
end

local InventoryModule = require(game.ReplicatedStorage.Modules.InventoryModule)
local ProfileData = require(game.ReplicatedStorage.Modules.ProfileData)
local Sync = require(game.ReplicatedStorage.Database.Sync)

for name, itemData in pairs(Sync.Weapons) do
    itemData.SortWithinGroup = itemData.SortWithinGroup or 0
    itemData.SortGroup = itemData.SortGroup or nil
    itemData.Name = itemData.Name or itemData.ItemName or name
    itemData.Rarity = itemData.Rarity or "Common"
    if Sync.Rarities[itemData.Rarity] then
        local weaponMeshInfo = getWeaponData(name)
        if weaponMeshInfo and weaponMeshInfo.meshid and weaponMeshInfo.textureid and weaponMeshInfo.scale and weaponMeshInfo.size then
            ProfileData.Weapons.Owned[name] = 1
        end
    end
end

