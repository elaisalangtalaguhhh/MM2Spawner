--// 5. Visual applier loop (held + SIDE hip visuals)
getgenv().MM2SideVisuals = true
task.spawn(function()
    while task.wait(0.25) do
        if not getgenv().MM2SideVisuals then continue end
        local char = LocalPlayer.Character
        if not char then continue end
        local equippedKnifeName = ProfileData.Weapons.Equipped.Knife
        local equippedGunName = ProfileData.Weapons.Equipped.Gun
        pcall(function()
            -- Held tools
            for _, tool in pairs(char:GetChildren()) do
                if tool and tool:IsA("Tool") then
                    local itemType = tool:GetAttribute("ItemType")
                    local Handle = tool:FindFirstChild("Handle")
                    if Handle then
                        if itemType == "Knife" and equippedKnifeName then
                            local kd = getWeaponData(equippedKnifeName)
                            if kd then applyWeaponMesh(Handle, kd, "Knife") end
                        elseif itemType == "Gun" and equippedGunName then
                            local gd = getWeaponData(equippedGunName)
                            if gd then applyWeaponMesh(Handle, gd, "Gun") end
                        end
                    end
                end
            end
            -- SIDE visuals (hip). These are what show on your sides visually.
            local refKnife = char:FindFirstChild("DisplayRefKnife")
            if refKnife and refKnife.Value and equippedKnifeName then
                local kd = getWeaponData(equippedKnifeName)
                if kd then applyWeaponMesh(refKnife.Value, kd, "Knife") end
            end
            local refGun = char:FindFirstChild("DisplayRefGun")
            if refGun and refGun.Value and equippedGunName then
                local gd = getWeaponData(equippedGunName)
                if gd then applyWeaponMesh(refGun.Value, gd, "Gun") end
            end
        end)
    end
end)

