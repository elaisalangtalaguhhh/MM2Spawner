local function findMeshAndTexture(node)
    if not node or type(node) ~= "table" then return nil end
    local props = node.Props
    if props then
        local meshId = props.MeshId or props.MeshID or props.SearchId or props.SearchID
        if meshId and meshId ~= "" then
            return {
                meshid = meshId,
                textureid = props.TextureId or props.TextureID or "",
                scale = props.Scale or Vector3.new(1,1,1),
                size = props.Size or Vector3.new(0.2697,1.2582,4.2087)
            }
        end
    end
    if node.Display and type(node.Display) == "table" then
        for _, child in ipairs(node.Display) do
            local p = child.Props
            if p then
                local mid = p.MeshId or p.MeshID or p.SearchId or p.SearchID
                if mid and mid ~= "" then
                    return {
                        meshid = mid,
                        textureid = p.TextureId or p.TextureID or "",
                        scale = p.Scale or Vector3.new(1,1,1),
                        size = p.Size or Vector3.new(0.2697,1.2582,4.2087)
                    }
                end
            end
        end
        local foundSize, foundMesh, foundTex, foundScale
        for _, child in ipairs(node.Display) do
            local p = child.Props
            if p then
                if p.Size then foundSize = p.Size end
                local mid = p.MeshId or p.MeshID or p.SearchId or p.SearchID
                if mid and mid ~= "" then foundMesh = mid end
                local tid = p.TextureId or p.TextureID
                if tid ~= nil then foundTex = tid end
                if p.Scale then foundScale = p.Scale end
            end
        end
        if foundMesh then
            return {meshid=foundMesh, textureid=foundTex or "", scale=foundScale or Vector3.new(1,1,1), size=foundSize or Vector3.new(0.045,0.045,0.045)}
        end
    end
    return nil
end

local function getWeaponData(name)
    local wd = data[name]
    if not wd then return nil end
    return findMeshAndTexture(wd)
end

-- Gingerscope only
local GINGER_ID = "15374602183"
if not _G.GingerOrig then _G.GingerOrig = {} end
if not _G.GingerWC then _G.GingerWC = {} end

-- Editable live values (editor changes these)
if _G.GingerHipRX == nil then _G.GingerHipRX = 180 end
if _G.GingerHipRY == nil then _G.GingerHipRY = 0 end
if _G.GingerHipRZ == nil then _G.GingerHipRZ = 0 end
if _G.GingerHeldRX == nil then _G.GingerHeldRX = 180 end
if _G.GingerHeldRY == nil then _G.GingerHeldRY = 0 end
if _G.GingerHeldRZ == nil then _G.GingerHeldRZ = 0 end
if _G.GingerScale == nil then _G.GingerScale = 0.75 end -- lower = smaller (fixes big)

local function isGingerData(wd)
    return wd and wd.meshid and wd.meshid:find(GINGER_ID) ~= nil
end

-- Get or create editable Motor6D for hip, replaces WeldConstraint once
local function getHipJoint(refPart, char)
    -- already made by us?
    local mine = refPart:FindFirstChild("GingerHipMotor")
    if mine and mine:IsA("Motor6D") then return mine end
    -- existing Motor6D / Weld
    local j = refPart:FindFirstChildOfClass("Motor6D") or refPart:FindFirstChildOfClass("Weld")
    if j then
        if not _G.GingerOrig[j] then _G.GingerOrig[j] = j.C0 end
        return j
    end
    -- search character for joint touching refPart
    if char then
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("Motor6D") or d:IsA("Weld") then
                if d.Part0 == refPart or d.Part1 == refPart then
                    if not _G.GingerOrig[d] then _G.GingerOrig[d] = d.C0 end
                    return d
                end
            end
        end
        -- WeldConstraint fallback: replace with Motor6D so we can rotate freely
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("WeldConstraint") then
                if d.Part0 == refPart or d.Part1 == refPart then
                    local other = (d.Part0 == refPart) and d.Part1 or d.Part0
                    if other then
                        d.Enabled = false
                        _G.GingerWC[refPart] = d
                        local m = Instance.new("Motor6D")
                        m.Name = "GingerHipMotor"
                        m.Part0 = other
                        m.Part1 = refPart
                        pcall(function()
                            m.C0 = other.CFrame:ToObjectSpace(refPart.CFrame)
                        end)
                        m.Parent = refPart
                        _G.GingerOrig[m] = m.C0
                        print("[Ginger] WeldConstraint replaced with Motor6D")
                        return m
                    end
                end
            end
        end
    end
    return nil
end

local function restoreHip(refPart)
    local mine = refPart:FindFirstChild("GingerHipMotor")
    if mine then
        mine:Destroy()
    end
    local wc = _G.GingerWC[refPart]
    if wc then
        pcall(function() wc.Enabled = true end)
        _G.GingerWC[refPart] = nil
    end
end

local function applyWeaponMesh(refPart, weaponData, weaponName, weapontype)
    if not weaponData or not weaponData.meshid then return end
    local ginger = isGingerData(weaponData)
    local char = game.Players.LocalPlayer.Character
    local isDisplay = (weapontype == nil) or (refPart:FindFirstAncestorOfClass("Tool") == nil)

    if ginger then
        -- HELD
        if not isDisplay and weapontype == "Gun" then
            local tool = refPart:FindFirstAncestorOfClass("Tool")
            if tool then
                local rx, ry, rz = math.rad(_G.GingerHeldRX), math.rad(_G.GingerHeldRY), math.rad(_G.GingerHeldRZ)
                tool.Grip = CFrame.new(Vector3.new(0, -0.5, 0.7)) * CFrame.Angles(rx, ry, rz)
            end
        end
        -- HIP
        if isDisplay and char then
            local joint = getHipJoint(refPart, char)
            if joint then
                local rx, ry, rz = math.rad(_G.GingerHipRX), math.rad(_G.GingerHipRY), math.rad(_G.GingerHipRZ)
                joint.C0 = _G.GingerOrig[joint] * CFrame.Angles(rx, ry, rz)
            end
        end
    else
        -- not ginger: restore hip if we touched it
        if isDisplay then
            pcall(function()
                local j = refPart:FindFirstChildOfClass("Motor6D") or refPart:FindFirstChildOfClass("Weld")
                if j and _G.GingerOrig[j] then joint = j; j.C0 = _G.GingerOrig[j] end
            end)
            restoreHip(refPart)
        else
            if weapontype == "Gun" then
                local tool = refPart:FindFirstAncestorOfClass("Tool")
                if tool then
                    if weaponData.meshid:find("79401392") then
                        tool.Grip = CFrame.fromMatrix(Vector3.new(0,-0.699999988,-0.300000012), Vector3.new(1,0,0), Vector3.new(0,0,1), Vector3.new(0,-1,0))
                    elseif weaponData.meshid:find("6600918074") then
                        tool.Grip = CFrame.new(1,-0.359999988,0.00000012,0,0,1,0,1,0,-1,0,0)
                    else
                        tool.Grip = CFrame.fromMatrix(Vector3.new(0,-0.5,0.7), Vector3.new(1,0,0), Vector3.new(0,1,0), Vector3.new(0,0,1))
                    end
                end
            end
        end
    end

    -- Mesh swap, ginger uses Scale slider so NOT big
    if refPart:IsA("MeshPart") then
        local sm = refPart:FindFirstChildOfClass("SpecialMesh")
        if sm then sm:Destroy() end
        if ginger then
            -- keep original part size, scale visual via Size * scale factor
            if not isDisplay then
                refPart.Size = weaponData.size * _G.GingerScale
            end
        else
            if not isDisplay then refPart.Size = weaponData.size end
        end
        refPart.MeshId = weaponData.meshid
        refPart.TextureID = weaponData.textureid
        -- MeshPart size scaling for hip to fix big:
        if ginger and isDisplay then
            -- shrink/grow around base size without changing part length too much:
            -- we scale Size but keep it proportional
            pcall(function()
                if not _G.GingerHipBaseSize then _G.GingerHipBaseSize = {} end
                if not _G.GingerHipBaseSize[refPart] then _G.GingerHipBaseSize[refPart] = refPart.Size end
                refPart.Size = _G.GingerHipBaseSize[refPart] * 1 -- keep part size
                -- visual scale via MeshId can't scale, so use Size factor:
                refPart.Size = weaponData.size * _G.GingerScale
            end)
        end
    else
        local mesh = refPart:FindFirstChildOfClass("SpecialMesh")
        if not mesh then
            mesh = Instance.new("SpecialMesh")
            mesh.Name = "Mesh"
            mesh.Parent = refPart
        end
        if ginger then
            mesh.MeshId = weaponData.meshid
            mesh.TextureId = weaponData.textureid
            -- positive scale * slider, rotation comes from joint not negative scale
            local s = _G.GingerScale
            mesh.Scale = Vector3.new(s, s, s)
            -- do NOT touch refPart.Size for hip = fixes big
            if not isDisplay then
                refPart.Size = weaponData.size
            end
        else
            refPart.Size = weaponData.size
            mesh.MeshId = weaponData.meshid
            mesh.TextureId = weaponData.textureid
            mesh.Scale = weaponData.scale
        end
    end
end

