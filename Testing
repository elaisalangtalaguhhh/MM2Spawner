-- Guess weapon type (Knife vs Gun) from Sync entry
local function guessType(name, itemData)
    if itemData then
        local t = itemData.ItemType or itemData.Type or itemData.WeaponType or itemData.Category
        if t == "Knife" or t == "Gun" then return t end
        if itemData.Gun == true then return "Gun" end
        if itemData.Knife == true then return "Knife" end
    end
    if Sync.Guns and Sync.Guns[name] then return "Gun" end
    if Sync.Knives and Sync.Knives[name] then return "Knife" end
    return nil
end

--// 4. Inventory spoof / refresh
local function RefreshInventoryUI()
    pcall(function()
        local UpdateInventory = filtergc("table", { Keys = { "UpdateInventory" } }, true).UpdateInventory
        if UpdateInventory then
            for _, func in pairs(getgc()) do
                if typeof(func) == "function" and islclosure(func) and debug.info(func, "l") == 122 and #debug.getupvalues(func) == 2 then
                    pcall(UpdateInventory, debug.getupvalue(func, 2), InventoryModule.MyInventory)
                    break
                end
            end
        end
    end)
end

local function UnlockWeapon(name)
    local itemData = Sync.Weapons[name]
    if not itemData then return false end
    itemData.SortWithinGroup = itemData.SortWithinGroup or 0
    itemData.SortGroup = itemData.SortGroup or nil
    itemData.Name = itemData.Name or itemData.ItemName or name
    itemData.Rarity = itemData.Rarity or "Common"
    ProfileData.Weapons.Owned[name] = 1
    return true
end

local function UnlockAll(filterType)
    local count = 0
    for name, itemData in pairs(Sync.Weapons) do
        local skip = false
        if filterType then
            local t = guessType(name, itemData)
            if t and t ~= filterType then skip = true end
            if t == nil and filterType ~= nil then
            end
        end
        if not skip then
            itemData.SortWithinGroup = itemData.SortWithinGroup or 0
            itemData.Name = itemData.Name or itemData.ItemName or name
            itemData.Rarity = itemData.Rarity or "Common"
            if Sync.Rarities[itemData.Rarity] then
                local info = getWeaponData(name)
                if info and info.meshid then
                    ProfileData.Weapons.Owned[name] = 1
                    count += 1
                end
            end
        end
    end
    RefreshInventoryUI()
    return count
end

local function EquipWeapon(name, weapontype)
    if not ProfileData.Weapons.Owned[name] then
        UnlockWeapon(name)
        RefreshInventoryUI()
    end
    pcall(function()
        ProfileData.Weapons.Equipped[weapontype] = name
    end)
    RefreshInventoryUI()
end

local function isMurder()
    local success, result = pcall(function()
        local char = LocalPlayer.Character
        if not char then return false end
        for _, v in pairs(char:GetChildren()) do
            if v:IsA("Tool") and v:GetAttribute("ItemType") == "Knife" then return true end
        end
        local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
        if bp then
            for _, v in pairs(bp:GetChildren()) do
                if v:IsA("Tool") and v:GetAttribute("ItemType") == "Knife" then return true end
            end
        end
        return false
    end)
    return success and result
end

