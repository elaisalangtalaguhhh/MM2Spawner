--// Gingerscope Rotation Editor

local Players = game:GetService("Players")
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "GingerscopeRotationEditor"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(260, 210)
frame.Position = UDim2.new(0, 20, 0.5, -105)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
frame.BorderSizePixel = 0
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 35)
title.BackgroundTransparency = 1
title.Text = "Gingerscope Rotation"
title.TextColor3 = Color3.new(1, 1, 1)
title.TextSize = 18
title.Font = Enum.Font.SourceSansBold
title.Parent = frame

local values = {
    X = 180,
    Y = 0,
    Z = 0
}

local boxes = {}

local function createBox(axis, y)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromOffset(35, 30)
    label.Position = UDim2.fromOffset(15, y)
    label.BackgroundTransparency = 1
    label.Text = axis
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextSize = 16
    label.Parent = frame

    local box = Instance.new("TextBox")
    box.Size = UDim2.fromOffset(180, 30)
    box.Position = UDim2.fromOffset(50, y)
    box.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    box.TextColor3 = Color3.new(1, 1, 1)
    box.TextSize = 16
    box.Text = tostring(values[axis])
    box.ClearTextOnFocus = false
    box.Parent = frame

    boxes[axis] = box

    box.FocusLost:Connect(function()
        local number = tonumber(box.Text)

        if number then
            values[axis] = number
        else
            box.Text = tostring(values[axis])
        end
    end)
end

createBox("X", 45)
createBox("Y", 85)
createBox("Z", 125)

local info = Instance.new("TextLabel")
info.Size = UDim2.new(1, -20, 0, 35)
info.Position = UDim2.fromOffset(10, 165)
info.BackgroundTransparency = 1
info.Text = "Edit X / Y / Z while playing"
info.TextColor3 = Color3.fromRGB(180, 180, 180)
info.TextSize = 13
info.Parent = frame


--// Find the displayed gun
local function getDisplayGun()
    local char = player.Character
    if not char then
        return nil
    end

    local display = char:FindFirstChild("DisplayRefGun")

    if display and display:IsA("ObjectValue") then
        return display.Value
    end

    return nil
end


local target = getDisplayGun()

if not target then
    warn("Could not find DisplayRefGun")
    return
end

-- Save the original CFrame
local originalCFrame = target.CFrame


--// Continuously apply rotation
game:GetService("RunService").RenderStepped:Connect(function()

    if not target or not target.Parent then
        return
    end

    local rotation =
        CFrame.Angles(
            math.rad(values.X),
            math.rad(values.Y),
            math.rad(values.Z)
        )

    target.CFrame = originalCFrame * rotation
end)
