if not isfile("mm2data.lua") then
    local result = request({
        Url = "https://raw.githubusercontent.com/Lutosys/opensrc/refs/heads/main/mm2meshes.lua",
        Method = "GET",
    })
    if result.Success then writefile("mm2data.lua", result.Body) end
end
data = loadfile("mm2data.lua")() or nil
if not data then return warn("failed to load data") end

local function findMeshAndTexture(node)
    if not node or type(node) ~= "table" then return nil end
    local props = node.Props
    if props then
        local meshId = props.MeshId or props.MeshID or props.SearchId or props.SearchID
        if meshId and meshId ~= "" then
            return {
                meshid = meshId,
                textureid = props.TextureId or props.TextureID or "",
                scale = props.Scale or Vector3.new(1,1,1),
                size = props.Size or Vector3.new(0.2697,1.2582,4.2087)
            }
        end
    end
    if node.Display and type(node.Display) == "table" then
        for _, child in ipairs(node.Display) do
            local p = child.Props
            if p then
                local mid = p.MeshId or p.MeshID or p.SearchId or p.SearchID
                if mid and mid ~= "" then
                    return {
                        meshid = mid,
                        textureid = p.TextureId or p.TextureID or "",
                        scale = p.Scale or Vector3.new(1,1,1),
                        size = p.Size or Vector3.new(0.2697,1.2582,4.2087)
                    }
                end
            end
        end
    end
    return nil
end

local function getWeaponData(name)
    local wd = data[name]
    if not wd then return nil end
    return findMeshAndTexture(wd)
end

local GINGER_ID = "15374602183"
local GINGER_SCALE = 0.65 -- sniper is long, 0.6-0.7 matches pic 2. 1.0 = full big.

getgenv().GingerRunId = (getgenv().GingerRunId or 0) + 1
local MY_RUN = getgenv().GingerRunId
if not _G.GingerOrig then _G.GingerOrig = {} end

local function applyWeaponMesh(refPart, weaponData, weaponName, weapontype)
    if not weaponData or not weaponData.meshid then return end
    local isGinger = weaponData.meshid:find(GINGER_ID) ~= nil
    local isDisplay = (weapontype == nil) or (refPart:FindFirstAncestorOfClass("Tool") == nil)

    if isGinger then
        if not isDisplay and weapontype == "Gun" then
            local tool = refPart:FindFirstAncestorOfClass("Tool")
            if tool then
                tool.Grip = CFrame.fromMatrix(
                    Vector3.new(0,-0.5,0.7),
                    Vector3.new(1,0,0),
                    Vector3.new(0,-1,0),
                    Vector3.new(0,0,-1)
                )
            end
        end
        if isDisplay then
            local joint = refPart:FindFirstChildOfClass("Motor6D") or refPart:FindFirstChildOfClass("Weld")
            if not joint and refPart.Parent then
                for _, c in ipairs(refPart.Parent:GetChildren()) do
                    if (c:IsA("Motor6D") or c:IsA("Weld")) and (c.Part0 == refPart or c.Part1 == refPart) then
                        joint = c break
                    end
                end
            end
            if joint then
                if not _G.GingerOrig[joint] then _G.GingerOrig[joint] = joint.C0 end
                joint.C0 = _G.GingerOrig[joint] * CFrame.Angles(math.rad(180),0,0)
            end
        end
    else
        if not isDisplay and weapontype == "Gun" then
            local tool = refPart:FindFirstAncestorOfClass("Tool")
            if tool then
                if weaponData.meshid:find("79401392") then
                    tool.Grip = CFrame.fromMatrix(Vector3.new(0,-0.699999988,-0.300000012), Vector3.new(1,0,0), Vector3.new(0,0,1), Vector3.new(0,-1,0))
                elseif weaponData.meshid:find("6600918074") then
                    tool.Grip = CFrame.new(1,-0.359999988,0.00000012,0,0,1,0,1,0,-1,0,0)
                else
                    tool.Grip = CFrame.fromMatrix(Vector3.new(0,-0.5,0.7), Vector3.new(1,0,0), Vector3.new(0,1,0), Vector3.new(0,0,1))
                end
            end
        end
        if isDisplay then
            pcall(function()
                local j = refPart:FindFirstChildOfClass("Motor6D") or refPart:FindFirstChildOfClass("Weld")
                if j and _G.GingerOrig[j] then j.C0 = _G.GingerOrig[j] end
            end)
        end
    end

    if refPart:IsA("MeshPart") then
        local sm = refPart:FindFirstChildOfClass("SpecialMesh")
        if sm then sm:Destroy() end
        if isGinger then
            refPart.Size = weaponData.size * GINGER_SCALE
        elseif not isDisplay then
            refPart.Size = weaponData.size
        end
        refPart.MeshId = weaponData.meshid
        refPart.TextureID = weaponData.textureid
    else
        local mesh = refPart:FindFirstChildOfClass("SpecialMesh")
        if not mesh then
            mesh = Instance.new("SpecialMesh")
            mesh.Name = "Mesh"
            mesh.Parent = refPart
        end
        if isGinger then
            mesh.MeshId = weaponData.meshid
            mesh.TextureId = weaponData.textureid
            if isDisplay then
                mesh.Scale = Vector3.new(GINGER_SCALE,-GINGER_SCALE,-GINGER_SCALE)
                refPart.Size = weaponData.size * GINGER_SCALE
            else
                refPart.Size = weaponData.size * GINGER_SCALE
                mesh.Scale = Vector3.new(GINGER_SCALE,GINGER_SCALE,GINGER_SCALE)
            end
        else
            refPart.Size = weaponData.size
            mesh.MeshId = weaponData.meshid
            mesh.TextureId = weaponData.textureid
            mesh.Scale = weaponData.scale
        end
    end
end

local InventoryModule = require(game.ReplicatedStorage.Modules.InventoryModule)
local ProfileData = require(game.ReplicatedStorage.Modules.ProfileData)
local Sync = require(game.ReplicatedStorage.Database.Sync)
for name, itemData in pairs(Sync.Weapons) do
    itemData.SortWithinGroup = itemData.SortWithinGroup or 0
    itemData.Name = itemData.Name or itemData.ItemName or name
    itemData.Rarity = itemData.Rarity or "Common"
    if Sync.Rarities[itemData.Rarity] then
        local wi = getWeaponData(name)
        if wi and wi.meshid then ProfileData.Weapons.Owned[name] = 1 end
    end
end
local UpdateInventory = filtergc("table", {Keys={"UpdateInventory"}}, true).UpdateInventory
for _, func in pairs(getgc()) do
    if typeof(func)=="function" and islclosure(func) and debug.info(func,"l")==122 and #debug.getupvalues(func)==2 then
        UpdateInventory(debug.getupvalue(func,2), InventoryModule.MyInventory)
    end
end

while wait() do
    if MY_RUN ~= getgenv().GingerRunId then break end
    local char = game.Players.LocalPlayer.Character
    if char then
        local kg = ProfileData.Weapons.Equipped.Gun
        local kn = ProfileData.Weapons.Equipped.Knife
        for _, tool in pairs(char:GetChildren()) do
            if tool and tool:IsA("Tool") then
                local it = tool:GetAttribute("ItemType")
                local H = tool:FindFirstChild("Handle")
                if H then
                    if it=="Knife" and kn then
                        local kd=getWeaponData(kn)
                        if kd then applyWeaponMesh(H,kd,kn,"Knife") end
                    elseif it=="Gun" and kg then
                        local gd=getWeaponData(kg)
                        if gd then applyWeaponMesh(H,gd,kg,"Gun") end
                    end
                end
            end
        end
        local rg=char:FindFirstChild("DisplayRefGun")
        if rg and rg.Value and kg then
            local gd=getWeaponData(kg)
            if gd then applyWeaponMesh(rg.Value,gd,kg) end
        end
        local rk=char:FindFirstChild("DisplayRefKnife")
        if rk and rk.Value and kn then
            local kd=getWeaponData(kn)
            if kd then applyWeaponMesh(rk.Value,kd,kn) end
        end
    end
end
