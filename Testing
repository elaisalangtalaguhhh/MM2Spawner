local function isMurder()
    local ok, res = pcall(function()
        for _, v in pairs(game.Players.LocalPlayer.Character:GetChildren()) do
            if v:IsA("Tool") and v:GetAttribute("ItemType")=="Knife" then return true end
        end
        for _, v in pairs(game.Players.LocalPlayer.Backpack:GetChildren()) do
            if v:IsA("Tool") and v:GetAttribute("ItemType")=="Knife" then return true end
        end
        return false
    end)
    if ok then return res end
    return false
end

game.Workspace.ChildAdded:Connect(function(ch)
    if ch and ch:IsA("BasePart") and ch.Name=="StuckKnife" then
        local m = ch:WaitForChild("Mesh")
        if m then
            local kn = ProfileData.Weapons.Equipped.Knife
            local kd = kn and getWeaponData(kn)
            if kd and isMurder() then
                m.MeshId=kd.meshid m.TextureId=kd.textureid m.Scale=kd.scale
            end
        end
    end
end)

while wait() do
    if MY_RUN ~= getgenv().GingerRunId then break end
    local char = game.Players.LocalPlayer.Character
    if char then
        local kn = ProfileData.Weapons.Equipped.Knife
        local kg = ProfileData.Weapons.Equipped.Gun
        for _, tool in pairs(char:GetChildren()) do
            if tool and tool:IsA("Tool") then
                local it = tool:GetAttribute("ItemType")
                local H = tool:FindFirstChild("Handle")
                if H then
                    if it=="Knife" and kn then
                        local kd=getWeaponData(kn)
                        if kd then applyWeaponMesh(H,kd,kn,"Knife") end
                    elseif it=="Gun" and kg then
                        local gd=getWeaponData(kg)
                        if gd then applyWeaponMesh(H,gd,kg,"Gun") end
                    end
                end
            end
        end
        local rg=char:FindFirstChild("DisplayRefGun")
        if rg and rg.Value and kg then
            local gd=getWeaponData(kg)
            if gd then applyWeaponMesh(rg.Value,gd,kg) end
        end
        local rk=char:FindFirstChild("DisplayRefKnife")
        if rk and rk.Value and kn then
            local kd=getWeaponData(kn)
            if kd then applyWeaponMesh(rk.Value,kd,kn) end
        end
    end
end
