-- ORIGINAL loader fixed: was SearchId, file uses MeshId
local function findMeshAndTexture(node)
    if not node or type(node) ~= "table" then return nil end
    local props = node.Props
    if props then
        local meshId = props.MeshId or props.MeshID or props.SearchId or props.SearchID
        if meshId and meshId ~= "" then
            return {
                meshid = meshId,
                textureid = props.TextureId or props.TextureID or "",
                scale = props.Scale or Vector3.new(1,1,1),
                size = props.Size or Vector3.new(0.2697,1.2582,4.2087),
                kind = props.Scale and "FileMesh" or "MeshPart"
            }
        end
    end
    if node.Display and type(node.Display) == "table" then
        local partSize
        for _, child in ipairs(node.Display) do
            local p = child.Props
            if p and p.Size then partSize = p.Size end
        end
        for _, child in ipairs(node.Display) do
            local p = child.Props
            if p then
                local mid = p.MeshId or p.MeshID or p.SearchId or p.SearchID
                if mid and mid ~= "" then
                    return {
                        meshid = mid,
                        textureid = p.TextureId or p.TextureID or "",
                        scale = p.Scale or Vector3.new(1,1,1),
                        size = p.Size or partSize or Vector3.new(0.2697,1.2582,4.2087),
                        kind = (child.Class == "MeshPart") and "MeshPart" or "FileMesh"
                    }
                end
            end
        end
    end
    return nil
end

local function getWeaponData(name)
    local wd = data[name]
    if not wd then return nil end
    return findMeshAndTexture(wd)
end

local GINGER_ID = "15374602183"
local HIP_RX = 135 -- back from -90 flip
local HIP_RY = 0 -- 180 spin from 180
local HIP_RZ = 0
local GINGER_DISPLAY_SCALE = 0.12 -- ginger hip only, a little smaller than 0.15
print("[Ginger] v360b SCALE=", GINGER_DISPLAY_SCALE, "RX=", HIP_RX, "RY=", HIP_RY, "RZ=", HIP_RZ)
getgenv().GingerRunId = (getgenv().GingerRunId or 0) + 1
local MY_RUN = getgenv().GingerRunId
if not _G.GingerOrig then _G.GingerOrig = {} end
if not _G.GingerWC then _G.GingerWC = {} end
if not _G.GingerHipLocked then _G.GingerHipLocked = {} end

local function getHipJoint(refPart, char)
    local mine = refPart:FindFirstChild("GingerHipMotor")
    if mine then return mine end
    local j = refPart:FindFirstChildOfClass("Motor6D") or refPart:FindFirstChildOfClass("Weld")
    if j then
        if not _G.GingerOrig[j] then _G.GingerOrig[j] = j.C0 end
        return j
    end
    local scopes = {}
    if char then table.insert(scopes, char) end
    if refPart.Parent then table.insert(scopes, refPart.Parent) end
    table.insert(scopes, game.Workspace)
    for _, scope in ipairs(scopes) do
        local ok, desc = pcall(function() return scope:GetDescendants() end)
        if ok and desc then
            for _, d in ipairs(desc) do
                if d:IsA("Motor6D") or d:IsA("Weld") then
                    if d.Part0 == refPart or d.Part1 == refPart then
                        if not _G.GingerOrig[d] then _G.GingerOrig[d] = d.C0 end
                        return d
                    end
                end
            end
        end
    end
    for _, scope in ipairs(scopes) do
        local ok, desc = pcall(function() return scope:GetDescendants() end)
        if ok and desc then
            for _, d in ipairs(desc) do
                if d:IsA("WeldConstraint") and (d.Part0 == refPart or d.Part1 == refPart) then
                    local other = (d.Part0 == refPart) and d.Part1 or d.Part0
                    if other then
                        d.Enabled = false
                        _G.GingerWC[refPart] = d
                        local m = Instance.new("Motor6D")
                        m.Name = "GingerHipMotor"
                        m.Part0 = other
                        m.Part1 = refPart
                        m.C0 = other.CFrame:ToObjectSpace(refPart.CFrame)
                        m.Parent = refPart
                        _G.GingerOrig[m] = m.C0
                        return m
                    end
                end
            end
        end
    end
    return nil
end

local function applyWeaponMesh(refPart, weaponData, weaponName, weapontype)
    if not weaponData or not weaponData.meshid then return end
    local isGinger = weaponData.meshid:find(GINGER_ID) ~= nil
    local isDisplay = (weapontype == nil) or (refPart:FindFirstAncestorOfClass("Tool") == nil)
    local char = game.Players.LocalPlayer.Character

    if isGinger then
        -- Locked hip: freeze perfect state. Hand forced default below.
        if isDisplay and _G.GingerHipLocked[refPart] then return end
        if not isDisplay and weapontype == "Gun" then
            -- Held Ginger default Grip (undo any accidental change)
            local tool = refPart:FindFirstAncestorOfClass("Tool")
            if tool then
                tool.Grip = CFrame.fromMatrix(Vector3.new(0,-0.5,0.7), Vector3.new(1,0,0), Vector3.new(0,1,0), Vector3.new(0,0,1))
            end
        end
        if isDisplay then
            local joint = getHipJoint(refPart, char)
            if joint then
                -- Only touch if display is Part1 (moves item). If display is Part0, C0 moves player.
                if joint.Part1 == refPart then
                    joint.C0 = _G.GingerOrig[joint] * CFrame.Angles(math.rad(HIP_RX),math.rad(HIP_RY),math.rad(HIP_RZ))
                else
                    print("[Ginger] SKIP backwards joint to avoid spinning player:", joint:GetFullName(), joint.ClassName)
                end
            else
                -- No joint: check RigidConstraint to player. If free preview, CFrame safe.
                local tiedToPlayer = false
                local scopes = {}
                if char then table.insert(scopes, char) end
                if refPart.Parent then table.insert(scopes, refPart.Parent) end
                table.insert(scopes, game.Workspace)
                for _, scope in ipairs(scopes) do
                    local ok, desc = pcall(function() return scope:GetDescendants() end)
                    if ok and desc then
                        for _, d in ipairs(desc) do
                            if d:IsA("RigidConstraint") then
                                -- RigidConstraint uses Attachments, check parents
                                local p0 = d.Attachment0 and d.Attachment0.Parent
                                local p1 = d.Attachment1 and d.Attachment1.Parent
                                if p0 == refPart or p1 == refPart then
                                    local other = (p0 == refPart) and p1 or p0
                                    if other and char and other:IsDescendantOf(char) then
                                        tiedToPlayer = true break
                                    end
                                end
                            elseif d:IsA("WeldConstraint") then
                                if d.Part0 == refPart or d.Part1 == refPart then
                                    local other = (d.Part0 == refPart) and d.Part1 or d.Part0
                                    if other and char and other:IsDescendantOf(char) then
                                        tiedToPlayer = true break
                                    end
                                end
                            end
                        end
                    end
                    if tiedToPlayer then break end
                end
                if tiedToPlayer then
                    local didAttach = false
                    for _, a in ipairs(refPart:GetChildren()) do
                        if a:IsA("Attachment") then
                            if not _G.GingerOrig[a] then _G.GingerOrig[a] = a.CFrame end
                            a.CFrame = _G.GingerOrig[a] * CFrame.Angles(math.rad(HIP_RX),math.rad(HIP_RY),math.rad(HIP_RZ))
                            didAttach = true
                        end
                    end
                    if not didAttach then
                        print("[Ginger] tied to player, left alone:", refPart:GetFullName())
                    end
                else
                    -- free Workspace preview: CFrame cannot spin player
                    if not _G.GingerCF then _G.GingerCF = {} end
                    if not _G.GingerCF[refPart] then _G.GingerCF[refPart] = refPart.CFrame end
                    refPart.CFrame = _G.GingerCF[refPart] * CFrame.Angles(math.rad(HIP_RX),math.rad(HIP_RY),math.rad(HIP_RZ))
                end
            end
        end
    else
        if not isDisplay and weapontype == "Gun" then
            local tool = refPart:FindFirstAncestorOfClass("Tool")
            if tool then
                if weaponData.meshid:find("79401392") then
                    tool.Grip = CFrame.fromMatrix(Vector3.new(0,-0.699999988,-0.300000012), Vector3.new(1,0,0), Vector3.new(0,0,1), Vector3.new(0,-1,0))
                elseif weaponData.meshid:find("6600918074") then
                    tool.Grip = CFrame.new(1,-0.359999988,0.00000012,0,0,1,0,1,0,-1,0,0)
                else
                    tool.Grip = CFrame.fromMatrix(Vector3.new(0,-0.5,0.7), Vector3.new(1,0,0), Vector3.new(0,1,0), Vector3.new(0,0,1))
                end
            end
        end
        if isDisplay then
            local j = refPart:FindFirstChildOfClass("Motor6D") or refPart:FindFirstChildOfClass("Weld")
            if j and _G.GingerOrig[j] then j.C0 = _G.GingerOrig[j] end
            local mine = refPart:FindFirstChild("GingerHipMotor")
            if mine then mine:Destroy() end
            local wc = _G.GingerWC[refPart]
            if wc then pcall(function() wc.Enabled = true end) _G.GingerWC[refPart] = nil end
        end
    end

    -- Mesh swap: skip cross-type (MeshPart<->FileMesh) except Ginger hip, so nothing goes gigantic.
    local targetKind = refPart:IsA("MeshPart") and "MeshPart" or "FileMesh"
    local sourceKind = weaponData.kind or "FileMesh"
    local gingerHip = isGinger and isDisplay
    if not gingerHip and sourceKind ~= targetKind then
        return -- leave game default size/rotation, no gigantic
    end
    if refPart:IsA("MeshPart") then
        local sm = refPart:FindFirstChildOfClass("SpecialMesh")
        if sm then sm:Destroy() end
        refPart.MeshId = weaponData.meshid
        refPart.TextureID = weaponData.textureid
        if gingerHip then _G.GingerHipLocked[refPart] = true end
    else
        local mesh = refPart:FindFirstChildOfClass("SpecialMesh")
        if not mesh then
            mesh = Instance.new("SpecialMesh")
            mesh.Name = "Mesh"
            mesh.Parent = refPart
        end
        mesh.MeshId = weaponData.meshid
        mesh.TextureId = weaponData.textureid
        local isGingerLocal = weaponData.meshid:find(GINGER_ID) ~= nil
        local isDisplayLocal = (weapontype == nil) or (refPart:FindFirstAncestorOfClass("Tool") == nil)
        if isGingerLocal and isDisplayLocal then
            -- upside down via X-flip, ginger hip only
            mesh.Scale = Vector3.new(GINGER_DISPLAY_SCALE,-GINGER_DISPLAY_SCALE,-GINGER_DISPLAY_SCALE)
            _G.GingerHipLocked[refPart] = true -- lock rotation+position+size
        end
        -- other weapons Scale untouched
    end
end

local InventoryModule = require(game.ReplicatedStorage.Modules.InventoryModule)
local ProfileData = require(game.ReplicatedStorage.Modules.ProfileData)
local Sync = require(game.ReplicatedStorage.Database.Sync)
for name, itemData in pairs(Sync.Weapons) do
